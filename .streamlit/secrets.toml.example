# Copy to .streamlit/secrets.toml for local runs, or paste into Streamlit Cloud > Settings > Secrets.
# The real secrets.toml is git-ignored. Never commit real keys.
# Only GEMINI_API_KEY is required. The others enable key rotation.
# Use keys from DIFFERENT Google Cloud projects; keys in one project share one quota.

GEMINI_API_KEY = "paste-key-here"
GEMINI_API_KEY1 = "paste-key-here-optional"
GEMINI_API_KEY2 = "paste-key-here-optional"
GEMINI_API_KEY3 = "paste-key-here-optional"
GEMINI_API_KEY4 = "paste-key-here-optional"
GEMINI_API_KEY5 = "paste-key-here-optional"
